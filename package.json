{
  "name": "legibility",
  "version": "0.0.0",
  "description": "Configure existing Legibility tools for readable code.",
  "bin": {
    "legibility": "./bin/legibility"
  },
  "files": [
    "bin/legibility",
    "skills",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types ./scripts/build/index.ts --cli-only && node --experimental-strip-types ./bin/legibility --help",
    "build:native": "node --experimental-strip-types ./scripts/build/index.ts",
    "build:native:release": "node --experimental-strip-types ./scripts/build/index.ts --release",
    "format": "oxfmt --config scripts/oxfmtrc.json --check .",
    "format:fix": "oxfmt --config scripts/oxfmtrc.json --write .",
    "lint": "oxlint --config scripts/oxlintrc.json src scripts tests --deny-warnings",
    "typecheck": "tsc --project scripts/tsconfig.json",
    "test": "node --test",
    "test:native": "pnpm run build:native:release && LEGIBILITY_NATIVE_E2E=1 node --test tests/e2e/native-cli.test.ts",
    "hooks:setup": "sh scripts/setup.sh",
    "prepare": "sh scripts/setup.sh && pnpm run build",
    "setup": "pnpm install && sh scripts/setup.sh && pnpm run build",
    "deps:check": "codependence --files package.json",
    "deps:security": "pastoralist --dry-run --checkSecurity --summary -d package.json"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "codependence": "^1.0.15",
    "eslint-plugin-legibility": "0.3.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.81.0",
    "pastoralist": "1.13.2",
    "rolldown": "1.2.5",
    "scriptc": "^0.0.35",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
