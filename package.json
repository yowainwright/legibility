{
  "name": "legibility",
  "version": "0.0.0",
  "description": "Configure existing Legibility tools for readable code.",
  "homepage": "https://github.com/yowainwright/legibility",
  "bugs": {
    "url": "https://github.com/yowainwright/legibility/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/legibility.git"
  },
  "bin": {
    "legibility": "./bin/js/legibility"
  },
  "files": [
    "bin/js/legibility",
    "docs",
    "skills",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --experimental-strip-types ./scripts/build/index.ts --cli-only && node --experimental-strip-types ./bin/js/legibility --help",
    "cli": "node --experimental-strip-types ./scripts/build/index.ts --cli-only && node ./bin/js/legibility",
    "build:native": "node --experimental-strip-types ./scripts/build/index.ts",
    "build:native:release": "node --experimental-strip-types ./scripts/build/index.ts --release",
    "readme:generate": "node --experimental-strip-types ./scripts/readme/index.ts",
    "readme:check": "node --experimental-strip-types ./scripts/readme/index.ts --check",
    "rules:generate": "node --experimental-strip-types ./scripts/rules/index.ts",
    "check": "nub run readme:check && nub run format && nub run lint && nub run typecheck && nub run build",
    "format": "oxfmt --config scripts/oxfmtrc.json --check .",
    "format:fix": "oxfmt --config scripts/oxfmtrc.json --write .",
    "lint": "nub run build:native && mise exec -- bin/native/legibility --config .legibilityrc",
    "typecheck": "tsc --project scripts/tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e": "pnpm run build:native:release && LEGIBILITY_NATIVE_E2E=1 node --test tests/e2e/*.test.ts",
    "test:native": "pnpm run test:e2e",
    "hooks:setup": "sh scripts/setup.sh",
    "prepare": "sh scripts/setup.sh && pnpm run build",
    "setup": "pnpm install && sh scripts/setup.sh && pnpm run build",
    "deps:check": "codependence --files package.json",
    "deps:security": "pastoralist --dry-run --checkSecurity --summary -d package.json",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:patch": "release-it patch",
    "release:patch:dry": "release-it patch --dry-run",
    "release:minor": "release-it minor",
    "release:minor:dry": "release-it minor --dry-run",
    "release:major": "release-it major",
    "release:major:dry": "release-it major --dry-run",
    "release:alpha": "release-it --preRelease=alpha",
    "release:alpha:dry": "release-it --preRelease=alpha --dry-run",
    "release:beta": "release-it --preRelease=beta",
    "release:beta:dry": "release-it --preRelease=beta --dry-run",
    "release:rc": "release-it --preRelease=rc",
    "release:rc:dry": "release-it --preRelease=rc --dry-run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "codependence": "^1.0.16",
    "github-slugger": "^2.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-legibility": "0.0.5",
    "pastoralist": "1.14.0",
    "release-it": "21.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rolldown": "1.2.15",
    "scriptc": "^0.4.6",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "release-it": {
    "hooks": {
      "before:init": "pnpm run check && pnpm run test"
    },
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    }
  }
}
