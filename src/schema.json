{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/legibility/src/schema.json",
  "x-revision": 4,
  "x-history": "https://github.com/yowainwright/legibility/commits/main/src/schema.json",
  "title": "Legibility Configuration",
  "description": "Configuration for selecting and invoking Legibility linters.",
  "type": "object",
  "additionalProperties": true,
  "required": ["linters"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Configuration schema URL."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Configuration format version."
    },
    "languages": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/language"
          }
        }
      ],
      "description": "Language IDs used by the project, as a list or keyed by stable language ID when language settings are present."
    },
    "linters": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "fs-lint",
          "src-lint",
          "struct-lint",
          "eslint-plugin-legibility",
          "oxlint-plugin-legibility",
          "go-lint-legibility",
          "ruff-legibility",
          "shellcheck-legibility",
          "sqlfluff-plugin-legibility"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/linter"
      },
      "description": "Linter configuration, keyed by stable linter ID."
    },
    "updates": {
      "$ref": "#/$defs/updates",
      "description": "Project policy for explicitly requested linter updates."
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "description": "Language-specific settings reserved for future defaults.",
      "additionalProperties": true
    },
    "linter": {
      "type": "object",
      "description": "Configuration passed to one underlying linter.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this linter runs by default."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Native command-line arguments passed unchanged to the linter."
        }
      },
      "additionalProperties": true
    },
    "updates": {
      "type": "object",
      "description": "Update policy for Homebrew-backed linters.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether Legibility may update project linters."
        },
        "manager": {
          "type": "string",
          "enum": ["brew"],
          "default": "brew",
          "description": "Package manager used for native linter updates."
        },
        "prompt": {
          "type": "boolean",
          "default": true,
          "description": "Whether to ask before refreshing, selecting, and upgrading linters."
        }
      },
      "additionalProperties": true
    }
  }
}
